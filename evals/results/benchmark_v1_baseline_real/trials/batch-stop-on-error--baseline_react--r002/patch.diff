+
+# --- stop_on_error ---------------------------------------------------------
+
+
+def test_stop_on_error_default_is_off():
+    service = CalculatorService()
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 1]},
+            {"operation": "nope", "args": []},
+            {"operation": "multiply", "args": [4, 3]},
+        ]
+    )
+    # Default keeps the per-item continuation behavior.
+    assert [r["ok"] for r in results] == [True, False, True]
+
+
+def test_stop_on_error_stops_at_first_failure():
+    service = CalculatorService(policy=OperationPolicy(stop_on_error=True))
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 1]},
+            {"operation": "nope", "args": []},
+            {"operation": "multiply", "args": [4, 3]},
+        ]
+    )
+    assert len(results) == 2
+    assert results[0] == {"ok": True, "value": 2}
+    assert results[1]["ok"] is False
+    assert results[1]["error"]["type"] == "UnknownOperationError"
+
+
+def test_stop_on_error_does_not_execute_later_requests():
+    calls = []
+
+    def recording_operation(a, b):
+        calls.append((a, b))
+        return a + b
+
+    service = CalculatorService(policy=OperationPolicy(stop_on_error=True))
+    service.registry.register("record", recording_operation)
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 2]},
+            {"operation": "divide", "args": [1, 0]},
+            {"operation": "record", "args": [5, 6]},
+        ]
+    )
+    assert [r["ok"] for r in results] == [True, False]
+    assert results[1]["error"]["type"] == "ZeroDivisionError"
+    assert calls == []
+
+
+def test_stop_on_error_with_no_failures_returns_all():
+    service = CalculatorService(policy=OperationPolicy(stop_on_error=True))
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 1]},
+            {"operation": "multiply", "args": [2, 3]},
+        ]
+    )
+    assert results == [
+        {"ok": True, "value": 2},
+        {"ok": True, "value": 6},
+    ]
+
+
+def test_stop_on_error_composes_with_max_batch_size():
+    service = CalculatorService(
+        policy=OperationPolicy(max_batch_size=2, stop_on_error=True)
+    )
+    results = service.execute_batch(
+        [
+            {"operation": "nope", "args": []},
+            {"operation": "add", "args": [1, 1]},
+        ]
+    )
+    assert len(results) == 1
+    assert results[0]["ok"] is False
+    assert results[0]["error"]["type"] == "UnknownOperationError"
