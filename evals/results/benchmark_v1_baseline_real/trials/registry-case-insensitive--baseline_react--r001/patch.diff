+def test_registry_lookup_is_case_insensitive_and_trims_whitespace():
+    registry = OperationRegistry()
+    registry.register("ADD", add)
+    # Registered as "ADD"; every spelling below must resolve to the same op.
+    for name in ("ADD", "add", "Add", "aDd", "  add  ", "\tADD\n"):
+        assert registry.resolve(name) is add
+
+
+def test_registry_register_normalizes_so_canonical_lookup_works():
+    registry = OperationRegistry()
+    registry.register("  Multiply  ", multiply)
+    assert registry.resolve("multiply") is multiply
+    assert registry.resolve("MULTIPLY") is multiply
+
+
+def test_registry_unknown_name_still_carries_original_spelling():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    with pytest.raises(UnknownOperationError) as exc_info:
+        registry.resolve("  Missing  ")
+    assert exc_info.value.name == "  Missing  "
+
+
+def test_service_execute_is_case_insensitive():
+    service = CalculatorService()
+    assert service.execute("ADD", 2, 3) == 5
+    assert service.execute("  Multiply ", 4, 3) == 12
+
