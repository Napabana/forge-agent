+def _normalize(name: str) -> str:
+    """Canonicalize an operation name for case-insensitive lookup.
+
+    Surrounding whitespace is ignored and the name is lowercased. The
+    canonical (already lowercase, trimmed) form is left unchanged.
+    """
+    return name.strip().lower()
+
