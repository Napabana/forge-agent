diff --git a/tests/test_calc_core.py b/tests/test_calc_core.py
index 1b00ac0..5af8ef7 100644
--- a/tests/test_calc_core.py
+++ b/tests/test_calc_core.py
@@ -74,6 +74,22 @@ def test_service_has_all_default_operations():
         assert service.registry.resolve(name) is not None
 
 
+def test_service_preserves_custom_registry_overrides():
+    registry = OperationRegistry()
+
+    def custom_add(a, b):
+        return a + b + 100
+
+    registry.register("add", custom_add)
+    service = CalculatorService(registry=registry)
+    # Pre-registered override is preserved...
+    assert service.execute("add", 1, 2) == 103
+    # ...while missing default operations are still installed.
+    for name in ("subtract", "multiply", "divide", "clamp"):
+        assert service.registry.resolve(name) is not None
+    assert service.execute("subtract", 5, 3) == 2
+
+
 def test_service_execute_dispatches_by_name():
     service = CalculatorService()
     assert service.execute("add", 2, 3) == 5
