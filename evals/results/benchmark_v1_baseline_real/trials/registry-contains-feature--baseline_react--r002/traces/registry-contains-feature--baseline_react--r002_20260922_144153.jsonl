{"event_id": "325191a4", "event_type": "observation", "task_id": "registry-contains-feature--baseline_react--r002", "timestamp": "2026-09-22T14:42:15.454500+00:00", "payload": {"step": 2, "observation": {"status": "success", "output": "  50 |     assert \"nope\" in str(err)\n  51 | \n  52 | \n  53 | # --- registry --------------------------------------------------------------\n  54 | \n  55 | \n  56 | def test_registry_register_and_resolve():\n  57 |     registry = OperationRegistry()\n  58 |     registry.register(\"add\", add)\n  59 |     assert registry.resolve(\"add\") is add\n  60 | \n  61 | \n  62 | def test_registry_unknown_name_raises_unknown_operation_error():\n  63 |     registry = OperationRegistry()\n  64 |     with pytest.raises(UnknownOperationError):\n  65 |         registry.resolve(\"missing\")\n  66 | \n  67 | \n  68 | # --- service ---------------------------------------------------------------\n  69 | \n  70 | \n  71 | def test_service_has_all_default_operations():\n  72 |     service = CalculatorService()\n  73 |     for name in (\"add\", \"subtract\", \"multiply\", \"divide\", \"clamp\"):\n  74 |         assert service.registry.resolve(name) is not None\n  75 | \n  76 | \n  77 | def test_service_execute_dispatches_by_name():\n  78 |     service = CalculatorService()\n  79 |     assert service.execute(\"add\", 2, 3) == 5\n  80 |     assert service.execute(\"subtract\", 5, 3) == 2\n  81 |     assert service.execute(\"multiply\", 4, 3) == 12\n  82 |     assert service.execute(\"divide\", 7, 2) == 3.5\n  83 |     assert service.execute(\"clamp\", 42, 0, 10) == 10\n  84 | \n  85 | \n  86 | def test_service_execute_unknown_operation_raises_unknown_operation_error():\n  87 |     service = CalculatorService()\n  88 |     with pytest.raises(UnknownOperationError):\n  89 |         service.execute(\"does_not_exist\", 1, 2)\n  90 | \n  91 | \n  92 | def test_service_execute_preserves_divide_by_zero():\n  93 |     service = CalculatorService()\n  94 |     with pytest.raises(ZeroDivisionError):\n  95 |         service.execute(\"divide\", 5, 0)\n  96 | \n  97 | \n  98 | # --- facade ----------------------------------------------------------------\n  99 | \n 100 | \n 101 | def test_facade_reexports_operations():\n 102 |     import calculator\n 103 | \n 104 |     assert calculator.add is operations.add\n 105 |     assert calculator.subtract is operations.subtract\n 106 |     assert calculator.multiply is operations.multiply\n 107 |     assert calculator.divide is operations.divide\n 108 |     assert calculator.clamp is operations.clamp\n[Lines 50–108 of 108. End of file.]", "tool_name": "file_view", "tokens_used": 0, "error": null, "error_type": null}, "trace_schema_version": 2, "schema_version": 2, "run_id": "registry-contains-feature--baseline_react--r002_20260922_144153", "run_span_id": "e248373fc69a42c6", "entrypoint": "eval", "session_id": null, "step_id": 2, "turn_id": "registry-contains-feature--baseline_react--r002_20260922_144153:2", "parent_span_id": "e248373fc69a42c6"}}
