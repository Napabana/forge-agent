 Operation = Callable[..., object]
 
 
+def _normalize_name(name: str) -> str:
+    """Return the canonical lookup key for ``name``.
+
+    Lookup is case-insensitive and tolerant of surrounding whitespace,
+    while the canonical lowercase form remains unchanged.
+    """
+    return name.strip().lower()
+
+
 class OperationRegistry:
     """Store operations by name and resolve them back."""
 
@@ -14,15 +23,20 @@ class OperationRegistry:
         self._operations: Dict[str, Operation] = {}
 
     def register(self, name: str, operation: Operation) -> None:
-        """Register ``operation`` under ``name``."""
-        self._operations[name] = operation
+        """Register ``operation`` under ``name``.
+
+        Names are normalized so that registration and lookup are
+        case-insensitive and ignore surrounding whitespace.
+        """
+        self._operations[_normalize_name(name)] = operation
 
     def resolve(self, name: str) -> Operation:
         """Return the operation registered under ``name``.
 
+        Lookup is case-insensitive and ignores surrounding whitespace.
         Raises UnknownOperationError if no such operation exists.
         """
         try:
-            return self._operations[name]
+            return self._operations[_normalize_name(name)]
         except KeyError:
             raise UnknownOperationError(name) from None
