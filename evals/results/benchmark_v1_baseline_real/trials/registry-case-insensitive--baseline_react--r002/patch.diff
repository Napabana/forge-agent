+def test_registry_lookup_is_case_insensitive_and_trims_whitespace():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    assert registry.resolve("ADD") is add
+    assert registry.resolve("Add") is add
+    assert registry.resolve("  add  ") is add
+
+
+def test_registry_registration_normalizes_case_and_whitespace():
+    registry = OperationRegistry()
+    registry.register("  MultiPly ", multiply)
+    assert registry.resolve("multiply") is multiply
+    assert registry.resolve("MULTIPLY") is multiply
+
+
+def test_registry_case_insensitive_miss_still_raises_with_original_name():
+    registry = OperationRegistry()
+    with pytest.raises(UnknownOperationError) as exc_info:
+        registry.resolve("  NOPE  ")
+    assert exc_info.value.name == "  NOPE  "
+
+
+def test_service_execute_is_case_insensitive_and_trims_whitespace():
+    service = CalculatorService()
+    assert service.execute("ADD", 2, 3) == 5
+    assert service.execute("  Divide  ", 7, 2) == 3.5
+
