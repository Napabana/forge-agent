+
+
+# --- stop_on_error ---------------------------------------------------------
+
+
+def test_policy_stop_on_error_defaults_to_false():
+    assert OperationPolicy().stop_on_error is False
+
+
+def test_stop_on_error_false_continues_after_failure():
+    service = CalculatorService(policy=OperationPolicy(stop_on_error=False))
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 1]},
+            {"operation": "divide", "args": [1, 0]},
+            {"operation": "add", "args": [5, 5]},
+        ]
+    )
+    assert [r["ok"] for r in results] == [True, False, True]
+    assert results[2] == {"ok": True, "value": 10}
+
+
+def test_stop_on_error_true_returns_through_first_failure():
+    service = CalculatorService(policy=OperationPolicy(stop_on_error=True))
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 1]},
+            {"operation": "divide", "args": [1, 0]},
+            {"operation": "add", "args": [5, 5]},
+            {"operation": "add", "args": [7, 7]},
+        ]
+    )
+    assert [r["ok"] for r in results] == [True, False]
+    assert results[1]["error"]["type"] == "ZeroDivisionError"
+
+
+def test_stop_on_error_true_does_not_execute_later_requests():
+    calls = []
+
+    def recording_add(a, b):
+        calls.append((a, b))
+        return a + b
+
+    registry = OperationRegistry()
+    registry.register("record", recording_add)
+    service = CalculatorService(
+        registry=registry, policy=OperationPolicy(stop_on_error=True)
+    )
+    results = service.execute_batch(
+        [
+            {"operation": "record", "args": [1, 1]},
+            {"operation": "nope", "args": []},
+            {"operation": "record", "args": [2, 2]},
+        ]
+    )
+    assert [r["ok"] for r in results] == [True, False]
+    assert calls == [(1, 1)]
+
+
+def test_stop_on_error_true_with_only_successes_is_unchanged():
+    service = CalculatorService(policy=OperationPolicy(stop_on_error=True))
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 1]},
+            {"operation": "add", "args": [2, 2]},
+        ]
+    )
+    assert results == [{"ok": True, "value": 2}, {"ok": True, "value": 4}]
+
+
+def test_stop_on_error_true_captures_validation_failure_and_stops():
+    service = CalculatorService(policy=OperationPolicy(stop_on_error=True))
+    results = service.execute_batch(
+        [
+            {"operation": "add", "args": [1, 1]},
+            "not-a-mapping",
+            {"operation": "add", "args": [3, 3]},
+        ]
+    )
+    assert [r["ok"] for r in results] == [True, False]
+    assert results[1]["error"]["type"] == "InvalidRequestError"
