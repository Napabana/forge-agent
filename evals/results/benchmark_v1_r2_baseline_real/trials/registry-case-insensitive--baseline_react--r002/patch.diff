+def test_registry_lookup_is_case_insensitive_and_strips_whitespace():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    # Canonical lowercase still works.
+    assert registry.resolve("add") is add
+    # Mixed case and surrounding whitespace resolve to the same operation.
+    assert registry.resolve("ADD") is add
+    assert registry.resolve("Add") is add
+    assert registry.resolve("  add  ") is add
+    assert registry.resolve("  AdD\t") is add
+    # Registration is normalized too.
+    other = OperationRegistry()
+    other.register("  SuBtRaCt ", subtract)
+    assert other.resolve("subtract") is subtract
+    # Unknown names still raise with the original name preserved.
+    with pytest.raises(UnknownOperationError) as exc_info:
+        registry.resolve("  MiSsInG ")
+    assert exc_info.value.name == "  MiSsInG "
+
+
+def test_service_execute_is_case_insensitive_and_strips_whitespace():
+    service = CalculatorService()
+    assert service.execute("add", 2, 3) == 5
+    assert service.execute("ADD", 2, 3) == 5
+    assert service.execute("  SuBtRaCt  ", 5, 3) == 2
+    assert service.execute("DiViDe", 7, 2) == 3.5
+
