diff --git a/src/calc_core/policy.py b/src/calc_core/policy.py
index 41350a5..08efd8d 100644
--- a/src/calc_core/policy.py
+++ b/src/calc_core/policy.py
@@ -21,14 +21,30 @@ class OperationPolicy:
             ``execute_batch``, or ``None`` for no limit.
         strict_validation: when ``True`` each batch request must contain
             exactly the keys ``"operation"`` and ``"args"``.
+        disabled_operations: frozenset of denied operation names, or
+            ``None`` for no explicit denials. A denied operation is
+            always disabled, even if it also appears in
+            ``enabled_operations``. Declared last so existing positional
+            construction of the other fields stays backward compatible.
     """
 
     enabled_operations: Optional[FrozenSet[str]] = None
     max_batch_size: Optional[int] = None
     strict_validation: bool = False
+    disabled_operations: Optional[FrozenSet[str]] = None
 
     def is_operation_enabled(self, operation_name: str) -> bool:
-        """Return whether ``operation_name`` is allowed by this policy."""
+        """Return whether ``operation_name`` is allowed by this policy.
+
+        An explicit denial always wins: an operation listed in
+        ``disabled_operations`` is disabled even when it is also present
+        in ``enabled_operations``.
+        """
+        if (
+            self.disabled_operations is not None
+            and operation_name in self.disabled_operations
+        ):
+            return False
         if self.enabled_operations is None:
             return True
         return operation_name in self.enabled_operations
diff --git a/tests/test_policy.py b/tests/test_policy.py
index c1dee57..bb41204 100644
--- a/tests/test_policy.py
+++ b/tests/test_policy.py
@@ -34,6 +34,7 @@ def test_operation_disabled_error_carries_name():
 def test_policy_defaults():
     policy = OperationPolicy()
     assert policy.enabled_operations is None
+    assert policy.disabled_operations is None
     assert policy.max_batch_size is None
     assert policy.strict_validation is False
 
@@ -51,6 +52,34 @@ def test_policy_is_operation_enabled():
     assert restricted.is_operation_enabled("divide") is False
 
 
+def test_policy_disabled_operations_deny_list():
+    policy = OperationPolicy(disabled_operations=frozenset({"divide"}))
+    assert policy.is_operation_enabled("add") is True
+    assert policy.is_operation_enabled("divide") is False
+
+
+def test_policy_disabled_operations_override_enabled():
+    policy = OperationPolicy(
+        enabled_operations=frozenset({"add", "divide"}),
+        disabled_operations=frozenset({"divide"}),
+    )
+    assert policy.is_operation_enabled("add") is True
+    # A denied operation is disabled even though it is also enabled.
+    assert policy.is_operation_enabled("divide") is False
+
+
+def test_policy_disabled_operations_default_allows_everything():
+    policy = OperationPolicy(disabled_operations=frozenset())
+    assert policy.is_operation_enabled("add") is True
+    assert policy.is_operation_enabled("divide") is True
+    assert policy.is_operation_enabled("anything") is True
+
+
+def test_default_policy_deny_list_none_is_backward_compatible():
+    assert OperationPolicy().disabled_operations is None
+    assert OperationPolicy().is_operation_enabled("divide") is True
+
+
 def test_policy_check_batch_size_boundary():
     assert OperationPolicy().check_batch_size(10 ** 6) is True
