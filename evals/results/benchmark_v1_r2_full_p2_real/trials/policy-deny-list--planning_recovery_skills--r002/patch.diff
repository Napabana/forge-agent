+# --- disabled_operations deny-list -----------------------------------------
+
+
+def test_deny_list_disables_operation_by_default():
+    policy = OperationPolicy(disabled_operations=frozenset({"divide"}))
+    assert policy.is_operation_enabled("add") is True
+    assert policy.is_operation_enabled("divide") is False
+
+
+def test_deny_list_overrides_enabled_operations():
+    policy = OperationPolicy(
+        enabled_operations=frozenset({"add", "divide"}),
+        disabled_operations=frozenset({"divide"}),
+    )
+    assert policy.is_operation_enabled("add") is True
+    assert policy.is_operation_enabled("divide") is False
+
+
+def test_deny_list_disables_even_when_enabled_operations_allows_all():
+    policy = OperationPolicy(disabled_operations=frozenset({"multiply"}))
+    service = CalculatorService(policy=policy)
+    assert service.execute("add", 1, 2) == 3
+    with pytest.raises(OperationDisabledError):
+        service.execute("multiply", 2, 3)
+
+
+def test_empty_deny_list_preserves_default_behavior():
+    policy = OperationPolicy(disabled_operations=frozenset())
+    assert policy.is_operation_enabled("add") is True
+    assert policy.is_operation_enabled("anything") is True
+
+
+def test_default_policy_deny_list_absent_stays_backward_compatible():
+    policy = OperationPolicy()
+    assert policy.is_operation_enabled("add") is True
+    assert policy.is_operation_enabled("divide") is True
+
+
+def test_execute_batch_captures_denied_operation_per_item():
+    service = CalculatorService(
+        policy=OperationPolicy(disabled_operations=frozenset({"divide"}))
+    )
+    results = service.execute_batch(
+        [
+            {"operation": "divide", "args": [6, 2]},
+            {"operation": "add", "args": [1, 2]},
+        ]
+    )
+    assert results[0]["ok"] is False
+    assert results[0]["error"]["type"] == "OperationDisabledError"
+    assert results[1] == {"ok": True, "value": 3}
+
+
 # --- max_batch_size --------------------------------------------------------
 
 
