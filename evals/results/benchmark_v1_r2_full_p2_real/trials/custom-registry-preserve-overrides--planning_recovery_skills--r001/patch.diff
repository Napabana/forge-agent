+def test_service_preserves_custom_registry_overrides_and_installs_defaults():
+    registry = OperationRegistry()
+
+    def custom_add(a, b):
+        return 1000 + a + b
+
+    registry.register("add", custom_add)
+    service = CalculatorService(registry=registry)
+
+    # The pre-registered override is preserved...
+    assert service.registry.resolve("add") is custom_add
+    assert service.execute("add", 2, 3) == 1005
+    # ...while the other default operations are still installed.
+    for name in ("subtract", "multiply", "divide", "clamp"):
+        assert service.registry.resolve(name) is not None
+
+
