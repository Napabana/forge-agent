+def test_registry_lookup_is_case_insensitive_and_ignores_whitespace():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    for variant in ("add", "ADD", "Add", " add ", "\tADD\n"):
+        assert registry.resolve(variant) is add
+    # Registration also normalizes, whichever case/spacing is used.
+    registry.register("  MULTIPLY  ", multiply)
+    assert registry.resolve("multiply") is multiply
+    # Unknown names still raise, carrying the original spelling.
+    with pytest.raises(UnknownOperationError) as exc_info:
+        registry.resolve("  Nope  ")
+    assert exc_info.value.name == "  Nope  "
+
+
