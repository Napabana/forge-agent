@@ -13,16 +13,28 @@ class OperationRegistry:
     def __init__(self) -> None:
         self._operations: Dict[str, Operation] = {}
 
+    @staticmethod
+    def _normalize(name: str) -> str:
+        """Return the canonical key for ``name``.
+
+        Names are matched case-insensitively and ignore surrounding
+        whitespace so ``"Add"``, ``" add "`` and ``"add"`` all refer to
+        the same operation.
+        """
+        return name.strip().lower()
+
     def register(self, name: str, operation: Operation) -> None:
         """Register ``operation`` under ``name``."""
-        self._operations[name] = operation
+        self._operations[self._normalize(name)] = operation
 
     def resolve(self, name: str) -> Operation:
         """Return the operation registered under ``name``.
 
+        Lookup is case-insensitive and ignores surrounding whitespace.
+
         Raises UnknownOperationError if no such operation exists.
         """
         try:
-            return self._operations[name]
+            return self._operations[self._normalize(name)]
         except KeyError:
             raise UnknownOperationError(name) from None
