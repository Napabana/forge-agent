+def test_registry_lookup_is_case_insensitive():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    assert registry.resolve("add") is add
+    assert registry.resolve("ADD") is add
+    assert registry.resolve("Add") is add
+
+
+def test_registry_lookup_ignores_surrounding_whitespace():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    assert registry.resolve(" add ") is add
+    assert registry.resolve("\tADD\n") is add
+
+
+def test_registry_registration_is_case_insensitive():
+    registry = OperationRegistry()
+    registry.register("  Add ", add)
+    assert registry.resolve("add") is add
+    assert registry.resolve("ADD") is add
+
+
+def test_registry_overwrites_across_case_variants():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    registry.register("ADD", subtract)
+    assert registry.resolve("add") is subtract
+    assert registry.resolve("Add") is subtract
+
+
+def test_registry_unknown_name_with_whitespace_raises():
+    registry = OperationRegistry()
+    registry.register("add", add)
+    with pytest.raises(UnknownOperationError) as exc_info:
+        registry.resolve("  missing  ")
+    assert exc_info.value.name == "  missing  "
+
+
